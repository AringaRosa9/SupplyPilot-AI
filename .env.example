# Shared runtime
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=supplypilot
POSTGRES_USER=supplypilot
POSTGRES_PASSWORD=supplypilot
DATABASE_URL=postgresql+asyncpg://supplypilot:supplypilot@postgres:5432/supplypilot

# Redis / worker
REDIS_URL=redis://redis:6379/0

# Browser and server-side API endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://api:8000
CORS_ORIGINS=http://localhost:3000
